# LLM（RAG / 普通问答常用：DashScope OpenAI 兼容接口）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
LLM_MODEL=qwen3.5-flash
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 病历分析（多 Agent）默认走 DeepSeek。仅跑 RAG 可保持注释；使用病历分析或 /api/agent* 时再取消注释并填写：
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_API_BASE=https://api.deepseek.com

# Agent：请求未带 model_provider 时的默认提供方（deepseek | qwen，默认 deepseek，见 python-service/app/config.py）
# AGENT_DEFAULT_LLM_PROVIDER=deepseek

# Agent：按角色覆盖模型 id（可选；不配则 DeepSeek 下各角色统一 deepseek-chat）。变量名示例：
# AGENT_MODEL_VALIDATOR=  AGENT_MODEL_EXTRACTOR=  AGENT_MODEL_ANALYST=
# AGENT_MODEL_TRIAGE_DEPT=  AGENT_MODEL_PLANNER=  AGENT_MODEL_COORDINATOR=
# 完整契约与 SSE error / phase 说明见 docs/design.md

# LangSmith（Tracing / 可观测性）
# Node 与 Python 进程均读取以下变量。开启后可在 LangSmith 查看全链路；Python 侧 Phase 1 工具调用为独立子 span（名称形如 tool:hybrid_retrieve），含耗时与错误输出。
# 流式 error 事件的可分类字段（code / retriable / phase 等）以 docs/design.md「type=error 与 phase」为准。
LANGSMITH_TRACING_V2=true
LANGSMITH_API_KEY=ls__your_langsmith_api_key_here
LANGSMITH_PROJECT=medical-ai

# Milvus向量数据库配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=medical_knowledge

# ElasticSearch配置
ES_HOST=localhost
ES_PORT=9200
ES_INDEX=medical_knowledge

# 嵌入模型配置
EMBEDDING_MODEL=BAAI/bge-large-zh

# 重排序模型配置
RERANKER_MODEL=BAAI/bge-reranker-large

# Neo4j配置（本机分别启动时通常连 Desktop；compose 部署请用 `.env.docker.example`）
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=medical_demo_2025
NEO4J_DATABASE=neo4j

# Redis配置（本机 Redis 默认 6379；compose 部署请用 `.env.docker.example`）
REDIS_URL=redis://localhost:6379

# Python服务配置
PYTHON_SERVICE_URL=http://localhost:8000

# Node服务配置
NODE_PORT=3001
