# Compose（云服务器）推荐配置：全部用 docker compose 里的服务名互联
#
# 用法：
#   cd medical-ai
#   cp .env.docker.example .env
#   # 填好密钥/密码后：
#   docker compose up -d
#
# 注意：容器内不要用 127.0.0.1 连接其他依赖，127.0.0.1 指向“当前容器自己”。

# LLM配置（Qwen Turbo via DashScope）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
LLM_MODEL=qwen3.5-flash
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# LangSmith（Tracing / 可观测性）
LANGSMITH_TRACING_V2=true
LANGSMITH_API_KEY=ls__your_langsmith_api_key_here
LANGSMITH_PROJECT=medical-ai

# Milvus向量数据库配置（compose service: milvus-standalone）
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=medical_knowledge

# ElasticSearch配置（compose service: elasticsearch）
ES_HOST=elasticsearch
ES_PORT=9200
ES_INDEX=medical_knowledge

# 嵌入/重排序模型配置
EMBEDDING_MODEL=BAAI/bge-large-zh
RERANKER_MODEL=BAAI/bge-reranker-large

# Neo4j配置（compose service: neo4j）
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=medical_demo_2025
NEO4J_DATABASE=neo4j

# Redis配置（compose service: redis）
REDIS_URL=redis://redis:6379

# Python服务配置（Node 容器访问 Python 容器用 service 名）
PYTHON_SERVICE_URL=http://python-service:8000

# Node服务配置
NODE_PORT=3001
